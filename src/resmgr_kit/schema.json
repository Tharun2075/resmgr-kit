{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "resmgr-kit spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "path", "state", "read"],
  "properties": {
    "name": {
      "description": "C identifier used for the binary, header and test names.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,23}$"
    },
    "path": {
      "description": "Path the resource manager attaches, e.g. /dev/vsensor0.",
      "type": "string",
      "pattern": "^/dev/(?!.*\\.\\.)[A-Za-z0-9_][A-Za-z0-9_./-]{0,62}$"
    },
    "description": {
      "description": "One line for the file headers; no control characters and no '*/'.",
      "type": "string", "maxLength": 200,
      "pattern": "^[^\\x00-\\x1f\\x7f]*$", "not": {"pattern": "\\*/"}
    },
    "buffer_size": {
      "description": "Size in bytes of the bounded read and write buffers.",
      "type": "integer", "minimum": 64, "maximum": 4096, "default": 256
    },
    "threads": {
      "description": "Run a dispatch thread pool instead of a single loop.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lo_water": {"type": "integer", "minimum": 1, "maximum": 64, "default": 2},
        "hi_water": {"type": "integer", "minimum": 1, "maximum": 64, "default": 4},
        "increment": {"type": "integer", "minimum": 1, "maximum": 64, "default": 1},
        "maximum": {"type": "integer", "minimum": 1, "maximum": 64, "default": 8}
      }
    },
    "state": {
      "description": "Named integer fields that make up the device state.",
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,23}$"},
          "type": {"enum": ["int32", "uint32"]},
          "init": {"type": "integer", "default": 0},
          "min": {"type": "integer"},
          "max": {"type": "integer"},
          "unit": {"type": "string", "maxLength": 16, "pattern": "^[^\\x00-\\x1f\\x7f]*$", "not": {"pattern": "\\*/"}}
        }
      }
    },
    "read": {
      "description": "A read returns one line 'field=value ...' with the latest state.",
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
          "items": {"type": "string"}
        }
      }
    },
    "write": {
      "description": "A write of a decimal number sets one field. Omit for a read-only device.",
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "properties": {
        "field": {"type": "string"},
        "out_of_range": {"enum": ["reject", "clamp"], "default": "reject"}
      }
    },
    "devctls": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "code", "op"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,31}$"},
          "code": {"type": "integer", "minimum": 1, "maximum": 255},
          "op": {
            "description": "set: client sends a value, gets the applied value back. get: client reads a field. notify: client registers a pulse for the notify trigger.",
            "enum": ["set", "get", "notify"]
          },
          "field": {"type": "string"},
          "out_of_range": {"enum": ["reject", "clamp"], "default": "reject"}
        }
      }
    },
    "timer": {
      "description": "Periodic pulse timer that runs the actions on every tick.",
      "type": "object",
      "additionalProperties": false,
      "required": ["actions"],
      "properties": {
        "period_ms": {"type": "integer", "minimum": 1, "maximum": 3600000},
        "rate_field": {"type": "string"},
        "actions": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "field"],
            "properties": {
              "op": {"enum": ["inc", "triangle"]},
              "field": {"type": "string"},
              "step": {"type": "integer", "minimum": 1, "maximum": 1000000, "default": 1},
              "amplitude": {"type": "integer", "minimum": 1, "maximum": 1000000000, "default": 1000}
            }
          }
        }
      },
      "oneOf": [
        {"required": ["period_ms"], "not": {"required": ["rate_field"]}},
        {"required": ["rate_field"], "not": {"required": ["period_ms"]}}
      ]
    },
    "notify": {
      "description": "When the field changes to the value, deliver the pulse to every armed client (one shot).",
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "equals"],
      "properties": {
        "field": {"type": "string"},
        "equals": {"type": "integer"},
        "count_field": {"type": "string"}
      }
    }
  }
}
