# {{ name }}.secpol - security policy snippet for {{ path }}.
# Generated by resmgr-kit from {{ spec_file }}. Add it to your policy source,
# compile it with secpolcompile and start the server with: on -T {{ name }}_t {{ name }}
# "resmgr-kit test --secpol" merges it into the target policy, pushes it and starts with on -S <file> -T.
# Secure mode needs a full system policy: harvest one from a --secpol=open run, then merge this snippet.
type {{ name }}_t;

# resmgr_attach() needs PROCMGR_AID_PATHSPACE; dispatch_create() makes a
# public channel, which needs PROCMGR_AID_PUBLIC_CHANNEL; a dynamic binary
# needs prot_exec and map_fixed to load.
allow {{ name }}_t self:ability {
    pathspace
    prot_exec
    map_fixed
    public_channel
};

# Only this path may be attached by {{ name }}_t.
allow_attach {{ name }}_t { {{ path }} };

# Launcher type (e.g. user_root_t) also needs: allow <launcher_t> self:ability { settypeid:{{ name }}_t channel_connect:{{ name }}_t };
