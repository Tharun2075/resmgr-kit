/* Device state. Every access holds state_lock: the timer pulse and the
 * I/O handlers{% if threads %} run on different pool threads{% else %} share it{% endif %}. */
static pthread_mutex_t state_lock = PTHREAD_MUTEX_INITIALIZER;
static struct {
{% for f in state %}    {{ f.ctype }} {{ f.name }};{% if f.unit %} /* {{ f.unit }} */{% endif %}

{% endfor %}} st = {
{% for f in state %}    .{{ f.name }} = {{ f.init }},
{% endfor %}};
{% if timer %}

static timer_t tick_timer;
static int tick_timer_ok;
{% endif %}
{% if notify %}

/* Clients armed for the notify trigger; each entry fires once. */
#define MAX_ARMED 16
static struct {
    int used;
    int rcvid;
    void *ocb;
    struct sigevent ev;
} armed[MAX_ARMED];

static void fire_armed(void)
{
    for (int i = 0; i < MAX_ARMED; i++) {
        if (armed[i].used) {
            (void)MsgDeliverEvent(armed[i].rcvid, &armed[i].ev);
            armed[i].used = 0;
        }
    }
}
{% endif %}
{% for f in state %}

/* Range check for '{{ f.name }}': {{ f.min }}..{{ f.max }}. Returns EOK with the
 * value in *out (clamped when clamp is set) or EINVAL. */
static inline int check_{{ f.name }}(long long in, int clamp, {{ f.ctype }} *out)
{
    const long long lo = {{ f.min }}LL, hi = {{ f.max }}LL;
    if (in < lo || in > hi) {
        if (!clamp)
            return EINVAL;
        in = in < lo ? lo : hi;
    }
    *out = ({{ f.ctype }})in;
    return EOK;
}
{% endfor %}
{% if timer %}

static void arm_tick_timer(void);
{% endif %}
{% for f in state %}

/* Set '{{ f.name }}' with state_lock held. */
static inline void set_{{ f.name }}({{ f.ctype }} v)
{
    {{ f.ctype }} old = st.{{ f.name }};
    st.{{ f.name }} = v;
{% if notify and notify.field == f.name %}
    if (old != v && v == {{ notify.equals }}) {
{% if notify.count_field %}
        if (st.{{ notify.count_field }} < {{ fields[notify.count_field].max }})
            st.{{ notify.count_field }}++;
{% endif %}
        fire_armed();
    }
{% endif %}
{% if timer and timer.rate_field == f.name %}
    if (old != v)
        arm_tick_timer();
{% endif %}
    (void)old;
}
{% endfor %}
{% if timer %}

static void arm_tick_timer(void)
{
    struct itimerspec its;
{% if timer.rate_field %}
    uint64_t period_ns = 1000000000ULL / (uint64_t)st.{{ timer.rate_field }};
{% else %}
    uint64_t period_ns = {{ timer.period_ms }}ULL * 1000000ULL;
{% endif %}
    if (!tick_timer_ok)
        return;
    its.it_value.tv_sec = period_ns / 1000000000ULL;
    its.it_value.tv_nsec = period_ns % 1000000000ULL;
    its.it_interval = its.it_value;
    (void)timer_settime(tick_timer, 0, &its, NULL);
}

/* Pulse handler: one timer tick. */
static int on_tick(message_context_t *ctp, int code, unsigned flags, void *handle)
{
    (void)ctp; (void)code; (void)flags; (void)handle;
    pthread_mutex_lock(&state_lock);
{% for a in timer.actions %}
{% set f = fields[a.field] %}
{% if a.op == "inc" %}
    set_{{ f.name }}(st.{{ f.name }} >= {{ f.max }} - {{ a.step }} ? {{ f.min }} : st.{{ f.name }} + {{ a.step }});
{% else %}
    {
        static int dir = 1;
        long long next = (long long)st.{{ f.name }} + dir * {{ a.step }}LL;
        if (next >= {{ a.amplitude }}LL) { next = {{ a.amplitude }}LL; dir = -1; }
        if (next <= -{{ a.amplitude }}LL) { next = -{{ a.amplitude }}LL; dir = 1; }
        set_{{ f.name }}(({{ f.ctype }})next);
    }
{% endif %}
{% endfor %}
    pthread_mutex_unlock(&state_lock);
    return 0;
}
{% endif %}

/* read(): one line "field=value ..." with the latest state; honours the offset. */
static int io_read(resmgr_context_t *ctp, io_read_t *msg, RESMGR_OCB_T *ocb)
{
    char text[BUFSZ];
    size_t len, nbytes;
    int status;

    if ((status = iofunc_read_verify(ctp, msg, ocb, NULL)) != EOK)
        return status;
    if ((msg->i.xtype & _IO_XTYPE_MASK) != _IO_XTYPE_NONE)
        return ENOSYS;

    pthread_mutex_lock(&state_lock);
    len = (size_t)snprintf(text, sizeof(text),
        "{% for n in read.fields %}{{ n }}={{ fields[n].fmt }}{{ ' ' if not loop.last }}{% endfor %}\n"{% for n in read.fields %},
        st.{{ n }}{% endfor %});
    pthread_mutex_unlock(&state_lock);
    if (len >= sizeof(text))
        len = sizeof(text) - 1;

    if (ocb->offset < 0 || (uint64_t)ocb->offset >= len) {
        _IO_SET_READ_NBYTES(ctp, 0);
        return _RESMGR_NPARTS(0); /* EOF */
    }
    nbytes = len - (size_t)ocb->offset;
    if (nbytes > msg->i.nbytes)
        nbytes = msg->i.nbytes;

    /* The receive buffer is at least BUFSZ bytes and the request is done
     * with, so the reply data can live there until the library replies. */
    memcpy(msg, text + ocb->offset, nbytes);
    ocb->offset += nbytes;
    ocb->attr->flags |= IOFUNC_ATTR_ATIME;
    _IO_SET_READ_NBYTES(ctp, nbytes);
    SETIOV(ctp->iov, msg, nbytes);
    return _RESMGR_NPARTS(1);
}

/* write(): {% if write %}a decimal number sets '{{ write.field }}' ({{ write.out_of_range }} outside {{ fields[write.field].min }}..{{ fields[write.field].max }}){% else %}read-only device{% endif %}. */
static int io_write(resmgr_context_t *ctp, io_write_t *msg, RESMGR_OCB_T *ocb)
{
    int status;

    if ((status = iofunc_write_verify(ctp, msg, ocb, NULL)) != EOK)
        return status;
    if ((msg->i.xtype & _IO_XTYPE_MASK) != _IO_XTYPE_NONE)
        return ENOSYS;
{% if write and write.impl == "ai" %}
    /* AI region io_write (sets '{{ write.field }}', {{ fields[write.field].ctype }}, {{ fields[write.field].min }}..{{ fields[write.field].max }}).
     * behaviour: {{ write.behaviour }}
     * Contract: read the text with resmgr_msgget() into a bounded buffer (BUFSZ), then
     * _IO_SET_WRITE_NBYTES() and return _RESMGR_NPARTS(0); or return an errno. Take
     * state_lock around st, use check_{{ write.field }}() and set_{{ write.field }}().
     * Only the lines between the markers change. */
    /* resmgr-kit:ai-begin io_write */
    return ENOSYS; /* stub: run `resmgr-kit ai` to fill this region */
    /* resmgr-kit:ai-end io_write */
{% elif write %}
    {
        char buf[BUFSZ], *end;
        size_t nbytes = _IO_WRITE_GET_NBYTES(msg);
        long long v;
        {{ fields[write.field].ctype }} value;

        if (nbytes == 0 || nbytes >= sizeof(buf))
            return EINVAL;
        if (resmgr_msgget(ctp, buf, nbytes, sizeof(msg->i)) != (ssize_t)nbytes)
            return EIO;
        buf[nbytes] = '\0';
        while (nbytes > 0 && (buf[nbytes - 1] == '\n' || buf[nbytes - 1] == '\r' ||
                              buf[nbytes - 1] == ' ' || buf[nbytes - 1] == '\t'))
            buf[--nbytes] = '\0';
        errno = 0;
        v = strtoll(buf, &end, 10);
        if (end == buf || *end != '\0' || errno != 0)
            return EINVAL;
        if ((status = check_{{ write.field }}(v, {{ 1 if write.out_of_range == "clamp" else 0 }}, &value)) != EOK)
            return status;

        pthread_mutex_lock(&state_lock);
        set_{{ write.field }}(value);
        pthread_mutex_unlock(&state_lock);

        _IO_SET_WRITE_NBYTES(ctp, _IO_WRITE_GET_NBYTES(msg));
        ocb->attr->flags |= IOFUNC_ATTR_MTIME | IOFUNC_ATTR_CTIME;
        return _RESMGR_NPARTS(0);
    }
{% else %}
    (void)ctp;
    return EROFS;
{% endif %}
}

{% if notify %}
/* close: drop any registration the closing client left armed. */
static int io_close_ocb(resmgr_context_t *ctp, void *reserved, RESMGR_OCB_T *ocb)
{
    pthread_mutex_lock(&state_lock);
    for (int i = 0; i < MAX_ARMED; i++) {
        if (armed[i].used && armed[i].ocb == ocb)
            armed[i].used = 0;
    }
    pthread_mutex_unlock(&state_lock);
    return iofunc_close_ocb_default(ctp, reserved, ocb);
}

{% endif %}
/* devctl(): the spec's command table. Bad sizes or values give EINVAL. */
static int io_devctl(resmgr_context_t *ctp, io_devctl_t *msg, RESMGR_OCB_T *ocb)
{
    int status;
    unsigned nbytes = 0;
    void *data;

    status = iofunc_devctl_default(ctp, msg, ocb);
    if (status != _RESMGR_DEFAULT)
        return status;

    data = _DEVCTL_DATA(msg->i);
    switch ((unsigned)msg->i.dcmd) {
{% for d in devctls %}
{% if d.op != "notify" %}{% set f = fields[d.field] %}{% endif %}
    case (unsigned)DCMD_{{ NAME }}_{{ d.name }}: {
{% if d.impl == "ai" %}
        /* AI region {{ d.name }} ({{ d.op }} '{{ d.field }}', {{ f.ctype }}, {{ f.min }}..{{ f.max }}).
         * behaviour: {{ d.behaviour }}
         * Contract: read the input at data (msg->i.nbytes bytes), put the reply at data,
         * set nbytes, then break; or return an errno. Take state_lock around st, use
         * check_{{ f.name }}() and set_{{ f.name }}(). Only the lines between the markers change. */
        /* resmgr-kit:ai-begin {{ d.name }} */
        return ENOSYS; /* stub: run `resmgr-kit ai` to fill this region */
        /* resmgr-kit:ai-end {{ d.name }} */
{% elif d.op == "set" %}
        {{ f.ctype }} in, out;
        if (msg->i.nbytes < sizeof(in) || ctp->info.msglen < sizeof(msg->i) + sizeof(in))
            return EINVAL;
        memcpy(&in, data, sizeof(in));
        if ((status = check_{{ f.name }}((long long)in, {{ 1 if d.out_of_range == "clamp" else 0 }}, &out)) != EOK)
            return status;
        pthread_mutex_lock(&state_lock);
        set_{{ f.name }}(out);
        pthread_mutex_unlock(&state_lock);
        memcpy(data, &out, sizeof(out));
        nbytes = sizeof(out);
        break;
{% elif d.op == "get" %}
        {{ f.ctype }} out;
        if (msg->i.nbytes < sizeof(out))
            return EINVAL;
        pthread_mutex_lock(&state_lock);
        out = st.{{ f.name }};
        pthread_mutex_unlock(&state_lock);
        memcpy(data, &out, sizeof(out));
        nbytes = sizeof(out);
        break;
{% else %}
        struct sigevent ev;
        int slot = -1;
        if (msg->i.nbytes < sizeof(ev) || ctp->info.msglen < sizeof(msg->i) + sizeof(ev))
            return EINVAL;
        memcpy(&ev, data, sizeof(ev));
        if (MsgVerifyEvent(ctp->rcvid, &ev) == -1)
            return errno;
        pthread_mutex_lock(&state_lock);
        for (int i = 0; i < MAX_ARMED; i++) {
            if (!armed[i].used) {
                slot = i;
                break;
            }
        }
        if (slot >= 0) {
            armed[slot].used = 1;
            armed[slot].rcvid = ctp->rcvid;
            armed[slot].ocb = ocb;
            armed[slot].ev = ev;
        }
        pthread_mutex_unlock(&state_lock);
        if (slot < 0)
            return EAGAIN;
        break;
{% endif %}
    }
{% endfor %}
    default:
        return ENOTTY;
    }

    memset(&msg->o, 0, sizeof(msg->o));
    msg->o.nbytes = nbytes;
    SETIOV(ctp->iov, &msg->o, sizeof(msg->o) + nbytes);
    return _RESMGR_NPARTS(1);
}

int main(int argc, char *argv[])
{
    dispatch_t *dpp;
    resmgr_attr_t rattr;
    int id;

    (void)argc;
    if ((dpp = dispatch_create()) == NULL) {
        perror("dispatch_create");
        return EXIT_FAILURE;
    }

    memset(&rattr, 0, sizeof(rattr));
    rattr.nparts_max = 1;
    rattr.msg_max_size = BUFSZ + 512;

    iofunc_func_init(_RESMGR_CONNECT_NFUNCS, &connect_funcs,
                     _RESMGR_IO_NFUNCS, &io_funcs);
    io_funcs.read = io_read;
    io_funcs.write = io_write;
    io_funcs.devctl = io_devctl;
{% if notify %}
    io_funcs.close_ocb = io_close_ocb;
{% endif %}

    iofunc_attr_init(&attr, S_IFCHR | {{ "0666" if write else "0444" }}, NULL, NULL);

    id = resmgr_attach(dpp, &rattr, {{ NAME }}_PATH, _FTYPE_ANY, 0,
                       &connect_funcs, &io_funcs, &attr);
    if (id == -1) {
        perror("resmgr_attach (needs PROCMGR_AID_PATHSPACE)");
        return EXIT_FAILURE;
    }
{% if timer %}

    {
        struct sigevent ev;
        int code, coid;

        code = pulse_attach(dpp, MSG_FLAG_ALLOC_PULSE, 0, on_tick, NULL);
        coid = message_connect(dpp, MSG_FLAG_SIDE_CHANNEL);
        if (code == -1 || coid == -1) {
            perror("pulse_attach/message_connect");
            return EXIT_FAILURE;
        }
        SIGEV_PULSE_INIT(&ev, coid, SIGEV_PULSE_PRIO_INHERIT, code, 0);
        if (timer_create(CLOCK_MONOTONIC, &ev, &tick_timer) == -1) {
            perror("timer_create");
            return EXIT_FAILURE;
        }
        tick_timer_ok = 1;
        pthread_mutex_lock(&state_lock);
        arm_tick_timer();
        pthread_mutex_unlock(&state_lock);
    }
{% endif %}

    printf("%s: ready on %s\n", argv[0], {{ NAME }}_PATH);
    fflush(stdout);
{% if threads %}

    {
        thread_pool_attr_t pattr;
        thread_pool_t *tpp;

        memset(&pattr, 0, sizeof(pattr));
        pattr.handle = dpp;
        pattr.context_alloc = dispatch_context_alloc;
        pattr.block_func = dispatch_block;
        pattr.unblock_func = dispatch_unblock;
        pattr.handler_func = dispatch_handler;
        pattr.context_free = dispatch_context_free;
        pattr.lo_water = {{ threads.lo_water }};
        pattr.hi_water = {{ threads.hi_water }};
        pattr.increment = {{ threads.increment }};
        pattr.maximum = {{ threads.maximum }};
        if ((tpp = thread_pool_create(&pattr, POOL_FLAG_EXIT_SELF)) == NULL) {
            perror("thread_pool_create");
            return EXIT_FAILURE;
        }
        thread_pool_start(tpp); /* does not return */
    }
    return EXIT_FAILURE;
{% else %}

    {
        dispatch_context_t *ctp = dispatch_context_alloc(dpp);
        if (ctp == NULL) {
            perror("dispatch_context_alloc");
            return EXIT_FAILURE;
        }
        for (;;) {
            if ((ctp = dispatch_block(ctp)) == NULL) {
                perror("dispatch_block");
                return EXIT_FAILURE;
            }
            dispatch_handler(ctp);
        }
    }
{% endif %}
}
