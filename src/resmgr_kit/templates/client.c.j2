/* {{ name }}_client.c - command-line client for {{ path }}.
 * Generated by resmgr-kit from {{ spec_file }}. Edit the spec, then run gen again.
 *
 * Usage:
{% for d in devctls %}
{% if d.op == "set" %}
 *   {{ name }}_client {{ d.name }} <value>
{% elif d.op == "get" %}
 *   {{ name }}_client {{ d.name }}
{% else %}
 *   {{ name }}_client {{ d.name }} <timeout_ms>   (prints "armed", then "pulse code=N" or "timeout")
{% endif %}
{% endfor %}
 *   {{ name }}_client RAW <dcmd>    (sends a bare command, to test unknown codes)
{% if devctls %}
 *   {{ name }}_client SHORT         (sends {{ devctls[0].name }} with a 2-byte payload, expects EINVAL)
{% endif %}
 * Prints "ok value=N" or "error errno=NAME (N)"; exits 0 on success, 1 on error.
 */
#include <errno.h>
#include <fcntl.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include <unistd.h>
#include <devctl.h>
#include <sys/neutrino.h>
#include "{{ name }}.h"

static const char *errname(int e)
{
    switch (e) {
    case EINVAL: return "EINVAL";
    case ENOTTY: return "ENOTTY";
    case ENOSYS: return "ENOSYS";
    case EAGAIN: return "EAGAIN";
    case EACCES: return "EACCES";
    case EPERM: return "EPERM";
    case ENOENT: return "ENOENT";
    case EROFS: return "EROFS";
    case ETIMEDOUT: return "ETIMEDOUT";
    default: return "OTHER";
    }
}

static int fail(int e)
{
    printf("error errno=%s (%d)\n", errname(e), e);
    return 1;
}

static int parse_ll(const char *s, long long *out)
{
    char *end;
    errno = 0;
    *out = strtoll(s, &end, 0);
    return (end != s && *end == '\0' && errno == 0) ? 0 : -1;
}

static int usage(void)
{
    fprintf(stderr, "usage: {{ name }}_client {% for d in devctls %}{{ d.name }}|{% endfor %}RAW|SHORT [value]\n");
    return 2;
}

int main(int argc, char *argv[])
{
    const char *cmd;
    long long v = 0;
    int fd, rc;

    if (argc < 2)
        return usage();
    cmd = argv[1];
    if (argc > 2 && parse_ll(argv[2], &v) != 0) {
        fprintf(stderr, "bad number: %s\n", argv[2]);
        return 2;
    }
    if ((fd = open({{ NAME }}_PATH, O_RDONLY)) == -1)
        return fail(errno);

{% if devctls %}
    if (strcmp(cmd, "SHORT") == 0) {
        int16_t data = 0;
        rc = devctl(fd, DCMD_{{ NAME }}_{{ devctls[0].name }}, &data, sizeof(data), NULL);
        if (rc != EOK)
            return fail(rc);
        printf("ok value=%d\n", data);
        return 0;
    }
{% endif %}
    if (strcmp(cmd, "RAW") == 0) {
        int32_t data = 0;
        if (argc < 3)
            return usage();
        rc = devctl(fd, (int)v, &data, sizeof(data), NULL);
        if (rc != EOK)
            return fail(rc);
        printf("ok value=%d\n", data);
        return 0;
    }
{% for d in devctls %}
    if (strcmp(cmd, "{{ d.name }}") == 0) {
{% if d.op == "set" %}
{% set f = fields[d.field] %}
        {{ f.ctype }} data;
        if (argc < 3)
            return usage();
        /* Pass out-of-type values through as-is so the server's checks are exercised. */
        data = ({{ f.ctype }})v;
        if (v < {{ -2147483648 if f.type == "int32" else 0 }}LL || v > {{ 2147483647 if f.type == "int32" else 4294967295 }}LL)
            return fail(EINVAL);
        rc = devctl(fd, DCMD_{{ NAME }}_{{ d.name }}, &data, sizeof(data), NULL);
        if (rc != EOK)
            return fail(rc);
        printf("ok value={{ f.fmt }}\n", data);
        return 0;
{% elif d.op == "get" %}
{% set f = fields[d.field] %}
        {{ f.ctype }} data = 0;
        rc = devctl(fd, DCMD_{{ NAME }}_{{ d.name }}, &data, sizeof(data), NULL);
        if (rc != EOK)
            return fail(rc);
        printf("ok value={{ f.fmt }}\n", data);
        return 0;
{% else %}
        struct sigevent ev;
        struct _pulse pulse;
        uint64_t timeout_ns;
        int chid, coid;

        if (argc < 3 || v < 1)
            return usage();
        /* A private channel: only this process connects to it, and under a
         * secure secpol a public one needs the public_channel ability. */
        if ((chid = ChannelCreate(_NTO_CHF_PRIVATE)) == -1 ||
            (coid = ConnectAttach(0, 0, chid, _NTO_SIDE_CHANNEL, 0)) == -1)
            return fail(errno);
        SIGEV_PULSE_INIT(&ev, coid, SIGEV_PULSE_PRIO_INHERIT, _PULSE_CODE_MINAVAIL, 0);
        /* QNX 8.0 only delivers events that the client registered first. */
        if (MsgRegisterEvent(&ev, fd) == -1)
            return fail(errno);
        rc = devctl(fd, DCMD_{{ NAME }}_{{ d.name }}, &ev, sizeof(ev), NULL);
        if (rc != EOK)
            return fail(rc);
        printf("armed\n");
        fflush(stdout);
        timeout_ns = (uint64_t)v * 1000000ULL;
        TimerTimeout(CLOCK_MONOTONIC, _NTO_TIMEOUT_RECEIVE, NULL, &timeout_ns, NULL);
        if (MsgReceivePulse(chid, &pulse, sizeof(pulse), NULL) == -1) {
            if (errno == ETIMEDOUT) {
                printf("timeout\n");
                return 1;
            }
            return fail(errno);
        }
        printf("pulse code=%d\n", pulse.code);
        return 0;
{% endif %}
    }
{% endfor %}
    return usage();
}
