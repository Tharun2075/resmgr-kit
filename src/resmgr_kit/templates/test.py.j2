import json
import os
import re
import shlex
import subprocess
import time

import pytest

SSH = json.loads(os.environ.get("RESMGR_KIT_SSH_ARGS", "null")) or [
    "ssh", "-p", "2222",
    "-o", "StrictHostKeyChecking=no", "-o", "UserKnownHostsFile=/dev/null",
    "-o", "LogLevel=ERROR", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5",
    "root@127.0.0.1",
]
REMOTE_DIR = os.environ.get("RESMGR_KIT_REMOTE_DIR", "/tmp")
PATH = "{{ path }}"
CLIENT = REMOTE_DIR + "/{{ name }}_client"
READ_RE = re.compile(r"^{% for n in read.fields %}{{ n }}=(-?\d+){{ ' ' if not loop.last }}{% endfor %}$")
LIMITS = {
{% for f in state %}
    "{{ f.name }}": ({{ f.min }}, {{ f.max }}),
{% endfor %}
}


def sh(cmd, timeout=20):
    """Run a shell command on the target; return the CompletedProcess."""
    return subprocess.run(SSH + [cmd], capture_output=True, text=True, timeout=timeout)


def read_state():
    out = sh("cat " + PATH)
    assert out.returncode == 0, out.stderr
    m = READ_RE.match(out.stdout.strip())
    assert m, "unexpected read output: %r" % out.stdout
    return dict(zip({{ read.fields | list }}, (int(g) for g in m.groups())))


def client(*args):
    """Run the generated client; return (ok, value or errno name, raw stdout)."""
    out = sh(" ".join([CLIENT] + [shlex.quote(str(a)) for a in args]))
    text = out.stdout.strip()
    m = re.search(r"ok value=(-?\d+)", text)
    if m:
        return True, int(m.group(1)), text
    m = re.search(r"error errno=(\w+)", text)
    return False, (m.group(1) if m else None), text


def test_path_exists():
    out = sh("ls -l " + PATH)
    assert out.returncode == 0, out.stderr
    assert out.stdout.startswith("{{ 'crw-rw-rw-' if write else 'cr--r--r--' }}"), out.stdout


def test_read_format():
    read_state()


def test_read_values_in_range():
    for name, value in read_state().items():
        lo, hi = LIMITS[name]
        assert lo <= value <= hi, (name, value)


def test_read_is_bounded():
    out = sh("dd if={{ path }} bs=1 count=1 2>/dev/null; echo")
    assert out.returncode == 0
    assert len(out.stdout.strip()) == 1, out.stdout
